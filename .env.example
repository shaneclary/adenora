# Adenora Production Environment
# Copy to .env.production and fill in real values

# Database
DATABASE_URL=postgres://adenora:CHANGE_ME@db/adenora
POSTGRES_USER=adenora
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=adenora

# Auth
# The server REFUSES TO START if JWT_SECRET or KYC_WEBHOOK_SECRET is left at the
# built-in default. Set real, random secrets in production. For local dev only
# you may bypass the check with ADENORA_ALLOW_INSECURE_DEFAULTS=1.
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
JWT_EXPIRY_HOURS=24
REFRESH_EXPIRY_DAYS=30

# Server
ADENORA_BIND=0.0.0.0:8080
RUST_LOG=info
# Comma-separated IPs of trusted reverse proxies (e.g. the Caddy front-end).
# X-Forwarded-For is only honored from these peers; otherwise the socket peer
# IP is used for rate limiting so clients can't spoof the header.
# ADENORA_TRUSTED_PROXIES=127.0.0.1
# CORS allowlist (comma-separated). Leave unset/"*" only for local dev.
# ADENORA_CORS_ORIGINS=https://adenora.app

# Domain (for Caddy TLS)
ADENORA_DOMAIN=adenora.app

# Trading
BATCH_INTERVAL_MS=500
MAX_CONTRACTS=1000
DISPUTE_WINDOW_HOURS=48
ORACLE_MIN_SOURCES=3

# Bot Arena
BOT_ARENA_ENABLED=true

# Lottery
# Default payout: 50% prizes, 25% project, 25% company (configurable per game)

# KYC Provider (Veriff)
# KYC_WEBHOOK_SECRET is required (see Auth note above) — the webhook rejects any
# request without a valid HMAC-SHA256 signature computed with this secret.
KYC_WEBHOOK_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET
KYC_PROVIDER=veriff
# VERIFF_API_KEY=
# VERIFF_API_SECRET=
# VERIFF_CALLBACK_URL=https://adenora.app/api/v1/kyc/webhook

# Payments
# SEPA_PROVIDER_KEY=
# CARD_PROCESSOR_KEY=
# POLYGON_RPC_URL=https://polygon-rpc.com
# USDC_CONTRACT=0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359
