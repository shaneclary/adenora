# Adenora preview — HTTP only, no domain required
# Access at http://5.78.182.190

:80 {
    handle /api/* {
        reverse_proxy adenora:8080
    }
    handle /ws {
        reverse_proxy adenora:8080
    }
    handle /healthz {
        reverse_proxy adenora:8080
    }
    handle {
        root * /srv/web
        try_files {path} /index.html
        file_server
    }
    encode gzip
}
